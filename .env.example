# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email (e.g., Gmail App Passwords)
EMAIL=your_email@example.com
EMAIL_APP_PASSWORD=your_email_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth-callback

# LINE OAuth
LINE_CLIENT_ID=your_line_client_id
LINE_CLIENT_SECRET=your_line_client_secret
LINE_REDIRECT_URI=http://localhost:5173/line-callback

# JWT Settings
JWT_ALGORITHM=HS256
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_RESET_SECRET=your_jwt_reset_secret

# Azure OCR (Computer Vision)
AZURE_VISION_ENDPOINT=https://your-azure-endpoint.cognitiveservices.azure.com/
AZURE_VISION_KEY=your_azure_vision_key

# Selenium Grid
SELENIUM_HUB_URL=http://localhost:4444/wd/hub

# API Base URL (used for generating webhook links, etc.)
BASE_URL=http://localhost:8000/
